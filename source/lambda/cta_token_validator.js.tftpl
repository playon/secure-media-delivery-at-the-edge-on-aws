// CTA-5007-B validator. Flags baked via templatefile.
import cf from 'cloudfront';

var TOKEN_ENFORCEMENT_MODE = "${token_enforcement_mode}";
var DMA_ENFORCEMENT_MODE = "${dma_enforcement_mode}";

// Pre-compile UA allowlists at init (cheap-per-request linear scan).
// Wrapped in try/catch per entry — Terraform's plan-time regexall is
// RE2, which differs from JS RegExp; a pattern that passes plan can
// still throw at init here. Without guarding, an init throw takes
// down the whole handler and every viewer request 5xxs. Skip + log
// instead, so a bad pattern only disables its own bypass line.
function compilePatterns(raw, listName) {
    var out = [];
    for (var i = 0; i < raw.length; i++) {
        try { out.push(new RegExp(raw[i])); }
        catch (e) { console.log("allowlist_pattern_compile_error list=" + listName + " pattern=" + raw[i] + " err=" + e.message); }
    }
    return out;
}
var LEGACY_CLIENT_ALLOWLIST_PATTERNS = compilePatterns(${legacy_client_allowlist_json}, "legacy_client_allowlist");
var DMA_BYPASS_ALLOWLIST_PATTERNS = compilePatterns(${dma_bypass_allowlist_json}, "dma_bypass_allowlist");

var CTA = { EXP: "4", NBF: "5", CTI: "7", CATNIP: "402", CATU: "401" };
var Catu = { PATH: "2" };
var CatuMatch = { PREFIX: "1" };

// Cache-Control: no-store so CF doesn't serve one viewer's per-request
// decision to another. CORS `*` so cross-origin JS can read the reject
// status + body (anonymous endpoint, no credentials).
function respond(statusCode, body) {
    return {
        statusCode: statusCode,
        body: body,
        headers: {
            'cache-control': { value: 'no-store, max-age=0' },
            'access-control-allow-origin': { value: '*' }
        }
    };
}

// Sanitize any client-controlled string before log-line concat:
// strip ASCII controls (CR/LF forgery guard) and cap at 64 chars.
function hdr(request, name) { var h = request.headers[name]; return h && h.value ? String(h.value).replace(/[\x00-\x1F\x7F]/g, "_").slice(0, 64) : "-"; }

// enforce → reject; log → log+forward; off handled by handler upstream.
function tokenReject(request, statusCode, reason) {
    console.log("token_reject reason=" + reason + " ua=" + hdr(request, "user-agent") + " client_version=" + hdr(request, "x-nfhs-client-version") + " mode=" + TOKEN_ENFORCEMENT_MODE);
    if (TOKEN_ENFORCEMENT_MODE === "enforce") return respond(statusCode, reason);
    return request;
}

// Unanchored — DMA check runs before the path token is stripped, so
// `^/broadcast/` would return null on path-token URIs and silently skip
// the blackout gate. Tokens are base64url (no `/`), so no false match.
function extractBroadcastId(uri) {
    var m = /\/broadcast\/([^\/]+)/.exec(uri);
    return m ? m[1] : null;
}

function isMetroBlocked(metroValue, blocklistCsv) {
    if (!metroValue || !blocklistCsv) return false;
    var list = blocklistCsv.split(',');
    var target = String(metroValue).trim();
    for (var i = 0; i < list.length; i++) {
        if (list[i].trim() === target) return true;
    }
    return false;
}

// Returns a response to short-circuit, or null to continue. Log mode
// always returns null after emitting the log line. DMA-bypass allowlist
// is checked AFTER the metro-block decision so the log line only fires
// on actual leaks — the metric rights-compliance cares about.
async function checkDmaBlackout(request, kvs) {
    if (DMA_ENFORCEMENT_MODE === "off") return null;
    var broadcastId = extractBroadcastId(request.uri);
    if (!broadcastId) return null;
    var blocklistCsv = null;
    try { blocklistCsv = await kvs.get("blackout:" + broadcastId); } catch (e) { return null; }
    if (!blocklistCsv) return null;
    var metroHeader = request.headers["cloudfront-viewer-metro-code"];
    // VID-3609 DEBUG (temp): confirm cache-policy-headers fix visible.
    console.log("dma_probe broadcast=" + broadcastId + " metro=" + (metroHeader ? metroHeader.value : "-"));
    if (!metroHeader) return null;
    if (!isMetroBlocked(metroHeader.value, blocklistCsv)) return null;

    // Bypass allowlist: UA match → forward (client has no blackout UI).
    // VID-3587 header override: if X-NFHS-Client-Version is present,
    // client HAS blackout UI, so revoke the bypass and let DMA fire.
    // Header applies to DMA list only, not legacy_client_allowlist.
    // Sanitize + cap value: attacker-controlled, and this log line
    // feeds the rights-compliance audit stream — CR/LF could forge
    // entries.
    var bypassPattern = matchesUaAllowlist(request, DMA_BYPASS_ALLOWLIST_PATTERNS);
    var capable = hdr(request, "x-nfhs-client-version");
    if (bypassPattern) {
        if (capable !== "-") {
            console.log("dma_bypass_revoked broadcast=" + broadcastId + " metro=" + metroHeader.value + " ua_pattern=" + bypassPattern + " client_version=" + capable + " mode=" + DMA_ENFORCEMENT_MODE);
        } else {
            console.log("dma_bypass_allowlist_hit broadcast=" + broadcastId + " metro=" + metroHeader.value + " pattern=" + bypassPattern + " client_version=- mode=" + DMA_ENFORCEMENT_MODE);
            return null;
        }
    }

    console.log("blackout_dma broadcast=" + broadcastId + " metro=" + metroHeader.value + " ua=" + hdr(request, "user-agent") + " client_version=" + capable + " mode=" + DMA_ENFORCEMENT_MODE);
    if (DMA_ENFORCEMENT_MODE === "enforce") return respond(451, "blackout_dma");
    return null;
}

// Shared UA-vs-patterns matcher. `patterns` is a pre-compiled RegExp
// array from compilePatterns(). Returns the matched RegExp.source
// string or null. Two separate allowlists (token check, DMA gate) call
// this against their own array — kept unified so a fix to header
// casing/multi-value/trimming lands in both places.
function matchesUaAllowlist(request, patterns) {
    if (patterns.length === 0) return null;
    var uaHeader = request.headers["user-agent"];
    if (!uaHeader || !uaHeader.value) return null;
    var ua = uaHeader.value;
    for (var i = 0; i < patterns.length; i++) {
        if (patterns[i].test(ua)) return patterns[i].source;
    }
    return null;
}

function validateClaims(payload, request, viewerIp) {
    var now = Math.floor(Date.now() / 1000);
    if (payload[CTA.EXP] && now > payload[CTA.EXP]) throw new Error("expired");
    if (payload[CTA.NBF] && now < payload[CTA.NBF]) throw new Error("not_yet_valid");
    if (payload[CTA.CATU] && payload[CTA.CATU][Catu.PATH] && payload[CTA.CATU][Catu.PATH][CatuMatch.PREFIX]) {
        if (!request.uri.startsWith(payload[CTA.CATU][Catu.PATH][CatuMatch.PREFIX])) throw new Error("uri_not_allowed");
    }
    if (payload[CTA.CATNIP] && viewerIp) {
        var allowed = payload[CTA.CATNIP];
        var ipMatch = false;
        for (var i = 0; i < allowed.length; i++) {
            if (allowed[i] === viewerIp) { ipMatch = true; break; }
        }
        if (!ipMatch) throw new Error("ip_restricted");
    }
}

async function handler(event) {
    try {
        var request = event.request;
        if (request.method === 'OPTIONS') {
            return {
                statusCode: 204,
                headers: {
                    'access-control-allow-origin': { value: '*' },
                    'access-control-allow-methods': { value: 'GET, HEAD, OPTIONS' },
                    'access-control-allow-headers': { value: 'CTA-Common-Access-Token' },
                    'access-control-max-age': { value: '86400' }
                }
            };
        }

        var kvs = cf.kvs();

        // Strip path-segment token from URI upfront so every downstream
        // branch (DMA extractBroadcastId, allowlist-bypass forward, token
        // check, origin fetch) sees the same clean `/broadcast/…` URI.
        // Without this, allowlist-bypassed UAs on path-token transport
        // forwarded `/<token>/broadcast/…` to origin and got 403.
        var pathToken = null;
        var segments = request.uri.split('/');
        if (segments[1] && segments[1].length > 50) {
            pathToken = segments[1];
            segments.splice(1, 1);
            request.uri = segments.join('/') || '/';
        }

        // DMA runs before token bypass — enforced even when token=off.
        var dmaResponse = await checkDmaBlackout(request, kvs);
        if (dmaResponse) return dmaResponse;

        if (TOKEN_ENFORCEMENT_MODE === "off") return request;

        var allowlistedPattern = matchesUaAllowlist(request, LEGACY_CLIENT_ALLOWLIST_PATTERNS);
        if (allowlistedPattern) {
            console.log("allowlist_bypass pattern=" + allowlistedPattern + " client_version=" + hdr(request, "x-nfhs-client-version"));
            return request;
        }

        var signingKey = await kvs.get("key:default");
        var token = null;
        var payload = null;

        if (request.headers["cta-common-access-token"]) {
            token = request.headers["cta-common-access-token"].value;
        } else if (request.querystring["CAT"]) {
            token = request.querystring["CAT"].value;
            delete request.querystring["CAT"];
        } else if (pathToken) {
            token = pathToken;
        } else {
            return tokenReject(request, 401, "missing_token");
        }

        var cwt = cf.cwt.validateToken(Buffer.from(token, 'base64url'), { key: signingKey });
        payload = cwt.payload;

        // 410 Gone (revoked) is distinct from 401 for client differentiation.
        if (payload[CTA.CTI]) {
            try {
                var revoked = await kvs.get("revoked:" + String(payload[CTA.CTI]));
                if (revoked) return tokenReject(request, 410, "token_revoked");
            } catch (e) { /* not revoked */ }
        }

        validateClaims(payload, request, event.viewer.ip);
        return request;
    } catch (e) {
        return tokenReject(event.request, 401, e.message);
    }
}
