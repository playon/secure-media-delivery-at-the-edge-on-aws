.IX Title "AWS::SecureMediaDelivery 3"
.TH AWS::SecureMediaDelivery 3 "2025-11-03" "perl v5.34.1" "User Contributed Perl Documentation"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH "NAME"
AWS::SecureMediaDelivery \- Perl SDK for Secure Media Delivery at the Edge on AWS
.SH "SYNOPSIS"
.IX Header "SYNOPSIS"
.Vb 3
\&    use AWS::SecureMediaDelivery::Secret;
\&    use AWS::SecureMediaDelivery::Token;
\&    use AWS::SecureMediaDelivery::Session;
\&    
\&    # Initialize secret manager
\&    my $secret = AWS::SecureMediaDelivery::Secret\->new(
\&        stack_name => \*(AqMyStack\*(Aq,
\&        ttl        => 300,
\&    );
\&    
\&    # Create token generator
\&    my $token = AWS::SecureMediaDelivery::Token\->new(secret => $secret);
\&    
\&    # Define viewer attributes
\&    my $viewer_attributes = {
\&        ip      => \*(Aq192.168.1.1\*(Aq,
\&        co      => \*(AqUS\*(Aq,
\&        headers => {
\&            \*(Aquser\-agent\*(Aq => \*(AqMozilla/5.0...\*(Aq,
\&            \*(Aqreferer\*(Aq    => \*(Aqhttps://example.com\*(Aq,
\&        },
\&    };
\&    
\&    # Define token policy
\&    my $token_policy = {
\&        ip      => 1,
\&        co      => 1,
\&        headers => [\*(Aquser\-agent\*(Aq, \*(Aqreferer\*(Aq],
\&        paths   => [\*(Aq/video/\*(Aq],
\&        exp     => \*(Aq+2h\*(Aq,
\&    };
\&    
\&    # Generate signed URL
\&    my $playback_url = \*(Aqhttps://example.cloudfront.net/video/stream.m3u8\*(Aq;
\&    my $signed_url = $token\->generate($viewer_attributes, $playback_url, $token_policy);
\&    
\&    print "Signed URL: $signed_url\en";
.Ve
.SH "DESCRIPTION"
.IX Header "DESCRIPTION"
This module provides a Perl \s-1SDK\s0 for the Secure Media Delivery at the Edge on \s-1AWS\s0 solution.
It allows you to generate secure \s-1JWT\s0 tokens for media delivery with support for \s-1IP\s0 validation,
geolocation, headers, query strings, and session management.
.SH "MODULES"
.IX Header "MODULES"
.IP "\(bu" 4
AWS::SecureMediaDelivery::Secret \- Manages cryptographic secrets
.IP "\(bu" 4
AWS::SecureMediaDelivery::Token \- Generates \s-1JWT\s0 tokens
.IP "\(bu" 4
AWS::SecureMediaDelivery::Session \- Manages session revocation
.SH "AUTHOR"
.IX Header "AUTHOR"
Amazon Web Services <aws\-solutions@amazon.com>
