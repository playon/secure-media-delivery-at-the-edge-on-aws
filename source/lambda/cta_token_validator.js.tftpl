// CTA-5007-B validator. See docs/plans/vid-3457-ua-allowlist.md and
// AGENTS.md for design context. Feature flags baked at deploy via
// Terraform templatefile: token_enforcement_mode (off|log|enforce),
// dma_enforcement_mode (off|log|enforce), legacy_client_allowlist_json,
// dma_bypass_allowlist_json.

import cf from 'cloudfront';

var TOKEN_ENFORCEMENT_MODE = "${token_enforcement_mode}";
var DMA_ENFORCEMENT_MODE = "${dma_enforcement_mode}";

// VID-3464: pre-compile UA allowlist at init.
var LEGACY_CLIENT_ALLOWLIST_PATTERNS = (function () {
    var raw = ${legacy_client_allowlist_json};
    var out = [];
    for (var i = 0; i < raw.length; i++) out.push(new RegExp(raw[i]));
    return out;
})();

// VID-3581: pre-compile DMA-bypass UA allowlist at init. Same
// pattern shape as LEGACY_CLIENT_ALLOWLIST_PATTERNS. Matches short-
// circuit the DMA gate specifically (not the token check) — see
// checkDmaBlackout below for the pre-check invocation.
var DMA_BYPASS_ALLOWLIST_PATTERNS = (function () {
    var raw = ${dma_bypass_allowlist_json};
    var out = [];
    for (var i = 0; i < raw.length; i++) out.push(new RegExp(raw[i]));
    return out;
})();

var CTA = { EXP: "4", NBF: "5", CTI: "7", CATNIP: "402", CATU: "401" };
var Catu = { PATH: "2" };
var CatuMatch = { PREFIX: "1" };

// Cache-Control: no-store on every rejection so CF doesn't serve one
// viewer's per-request decision to another.
//
// Access-Control-Allow-Origin: * so cross-origin JS can read the 401/410/451
// status + body. Without this header the browser blocks JS from seeing the
// response at all (fetch() rejects opaquely, XHR gets no readable body), so
// a client-side HEAD-then-branch-on-451 check silently fails and falls back
// to a less-reliable path. The origin's 200 responses already set CORS
// upstream; validator-generated rejects have to mirror that. `*` matches
// the OPTIONS preflight handler below and is safe here because the endpoint
// is anonymous (no credentials).
function respond(statusCode, body) {
    return {
        statusCode: statusCode,
        body: body,
        headers: {
            'cache-control': { value: 'no-store, max-age=0' },
            'access-control-allow-origin': { value: '*' }
        }
    };
}

// VID-3464: enforce → reject; log → log+forward; off handled upstream.
function tokenReject(request, statusCode, reason) {
    console.log("token_reject reason=" + reason + " mode=" + TOKEN_ENFORCEMENT_MODE);
    if (TOKEN_ENFORCEMENT_MODE === "enforce") return respond(statusCode, reason);
    return request;
}

function extractBroadcastId(uri) {
    var m = /^\/broadcast\/([^\/]+)/.exec(uri);
    return m ? m[1] : null;
}

function extractPathToken(request) {
    var segments = request.uri.split('/');
    if (segments[1] && segments[1].length > 50) return segments[1];
    return null;
}

function isMetroBlocked(metroValue, blocklistCsv) {
    if (!metroValue || !blocklistCsv) return false;
    var list = blocklistCsv.split(',');
    var target = String(metroValue).trim();
    for (var i = 0; i < list.length; i++) {
        if (list[i].trim() === target) return true;
    }
    return false;
}

// Returns a response to short-circuit, or null to continue. Log mode
// always returns null after emitting the log line.
//
// VID-3581: DMA-bypass allowlist is checked AFTER the metro-block
// decision, not before. Rights-compliance cares about "how many
// blocks did the bypass let through" — a metric that's meaningful
// only when we know the block WOULD have fired. Checking bypass
// before the KVS lookup would save a per-request lookup but would
// also log every bypass-allowlisted request regardless of whether
// it was ever going to be blocked (80% of prod traffic if
// AppleCoreMedia is on the list); that noise is useless to
// compliance and dilutes the audit signal. Trade the per-request
// KVS lookup on bypass-allowlisted UAs for a precise
// `dma_bypass_allowlist_hit` count = actual blackout leak.
async function checkDmaBlackout(request, kvs) {
    if (DMA_ENFORCEMENT_MODE === "off") return null;
    var broadcastId = extractBroadcastId(request.uri);
    if (!broadcastId) return null;
    var blocklistCsv = null;
    try { blocklistCsv = await kvs.get("blackout:" + broadcastId); } catch (e) { return null; }
    if (!blocklistCsv) return null;
    var metroHeader = request.headers["cloudfront-viewer-metro-code"];
    if (!metroHeader) return null;
    if (!isMetroBlocked(metroHeader.value, blocklistCsv)) return null;

    // At this point the viewer WOULD be blocked. If their UA is on
    // the bypass allowlist, log the leak and let them through
    // instead of returning 451.
    var bypassPattern = matchesDmaBypassAllowlist(request);
    if (bypassPattern) {
        console.log("dma_bypass_allowlist_hit broadcast=" + broadcastId + " metro=" + metroHeader.value + " pattern=" + bypassPattern + " mode=" + DMA_ENFORCEMENT_MODE);
        return null;
    }

    console.log("blackout_dma broadcast=" + broadcastId + " metro=" + metroHeader.value + " mode=" + DMA_ENFORCEMENT_MODE);
    if (DMA_ENFORCEMENT_MODE === "enforce") return respond(451, "blackout_dma");
    return null;
}

// VID-3464: transitional UA allowlist. Linear scan; keep list < 20.
function matchesLegacyAllowlist(request) {
    if (LEGACY_CLIENT_ALLOWLIST_PATTERNS.length === 0) return null;
    var uaHeader = request.headers["user-agent"];
    if (!uaHeader || !uaHeader.value) return null;
    var ua = uaHeader.value;
    for (var i = 0; i < LEGACY_CLIENT_ALLOWLIST_PATTERNS.length; i++) {
        if (LEGACY_CLIENT_ALLOWLIST_PATTERNS[i].test(ua)) return LEGACY_CLIENT_ALLOWLIST_PATTERNS[i].source;
    }
    return null;
}

// VID-3581: transitional DMA-bypass UA allowlist. Same linear-scan
// shape as matchesLegacyAllowlist. Distinct list because bypassing
// blackout enforcement has different policy semantics from bypassing
// token validation (rights-compliance sign-off required per VID-3581)
// and a distinct retirement condition — each entry sunsets when its
// app team ships blackout-message UI (VID-3507 tracking).
function matchesDmaBypassAllowlist(request) {
    if (DMA_BYPASS_ALLOWLIST_PATTERNS.length === 0) return null;
    var uaHeader = request.headers["user-agent"];
    if (!uaHeader || !uaHeader.value) return null;
    var ua = uaHeader.value;
    for (var i = 0; i < DMA_BYPASS_ALLOWLIST_PATTERNS.length; i++) {
        if (DMA_BYPASS_ALLOWLIST_PATTERNS[i].test(ua)) return DMA_BYPASS_ALLOWLIST_PATTERNS[i].source;
    }
    return null;
}

function validateClaims(payload, request, viewerIp) {
    var now = Math.floor(Date.now() / 1000);
    if (payload[CTA.EXP] && now > payload[CTA.EXP]) throw new Error("expired");
    if (payload[CTA.NBF] && now < payload[CTA.NBF]) throw new Error("not_yet_valid");
    if (payload[CTA.CATU] && payload[CTA.CATU][Catu.PATH] && payload[CTA.CATU][Catu.PATH][CatuMatch.PREFIX]) {
        if (!request.uri.startsWith(payload[CTA.CATU][Catu.PATH][CatuMatch.PREFIX])) throw new Error("uri_not_allowed");
    }
    if (payload[CTA.CATNIP] && viewerIp) {
        var allowed = payload[CTA.CATNIP];
        var ipMatch = false;
        for (var i = 0; i < allowed.length; i++) {
            if (allowed[i] === viewerIp) { ipMatch = true; break; }
        }
        if (!ipMatch) throw new Error("ip_restricted");
    }
}

async function handler(event) {
    try {
        var request = event.request;
        if (request.method === 'OPTIONS') {
            return {
                statusCode: 204,
                headers: {
                    'access-control-allow-origin': { value: '*' },
                    'access-control-allow-methods': { value: 'GET, HEAD, OPTIONS' },
                    'access-control-allow-headers': { value: 'CTA-Common-Access-Token' },
                    'access-control-max-age': { value: '86400' }
                }
            };
        }

        var kvs = cf.kvs();

        // DMA runs before token bypass — regional blackouts enforce
        // even when tokens are off.
        var dmaResponse = await checkDmaBlackout(request, kvs);
        if (dmaResponse) return dmaResponse;

        if (TOKEN_ENFORCEMENT_MODE === "off") return request;

        var allowlistedPattern = matchesLegacyAllowlist(request);
        if (allowlistedPattern) {
            console.log("allowlist_bypass pattern=" + allowlistedPattern);
            return request;
        }

        var signingKey = await kvs.get("key:default");
        var token = null;
        var payload = null;

        // Strip token from URI/query BEFORE validation so log-mode
        // failure paths forward a clean request to origin.
        if (request.headers["cta-common-access-token"]) {
            token = request.headers["cta-common-access-token"].value;
        } else if (request.querystring["CAT"]) {
            token = request.querystring["CAT"].value;
            delete request.querystring["CAT"];
        } else {
            token = extractPathToken(request);
            if (!token) return tokenReject(request, 401, "missing_token");
            var segments = request.uri.split('/');
            segments.splice(1, 1);
            request.uri = segments.join('/') || '/';
        }

        var cwt = cf.cwt.validateToken(Buffer.from(token, 'base64url'), { key: signingKey });
        payload = cwt.payload;

        // 410 Gone (revoked) is distinct from generic 401 so clients
        // can tell a revoked token apart from a plain-invalid one.
        if (payload[CTA.CTI]) {
            try {
                var revoked = await kvs.get("revoked:" + String(payload[CTA.CTI]));
                if (revoked) return tokenReject(request, 410, "token_revoked");
            } catch (e) { /* not revoked */ }
        }

        validateClaims(payload, request, event.viewer.ip);
        return request;
    } catch (e) {
        return tokenReject(event.request, 401, e.message);
    }
}
